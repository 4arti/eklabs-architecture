# Copy to .env and fill in real values. .env is gitignored; this file is
# the only one of the two that's tracked, so it's the living list of every
# variable the app actually reads from the environment.

# --- Database (Supabase) ----------------------------------------------------
# Session pooler (port 5432), eklabs_migrator role — used by `alembic`.
ALEMBIC_DATABASE_URL=postgresql+psycopg2://eklabs_migrator.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Transaction pooler (port 6543), eklabs_app role — used by the app/tests.
APP_DATABASE_URL=postgresql+asyncpg://eklabs_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- File storage (Supabase Storage, S3-compatible) -------------------------
# Project Settings -> Storage -> S3 Connection.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Background jobs (Redis + Arq) ------------------------------------------
# docker compose up -d redis -> redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Claude gateway (platform/llm/ only) -------------------------------------
# console.anthropic.com — NOT the same thing as a Claude.ai Pro subscription.
ANTHROPIC_API_KEY=

# --- Langfuse Cloud (tracing) ------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Omit unless self-hosting or on the EU region — defaults to Langfuse's
# US cloud host.
# LANGFUSE_HOST=
